{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Root organization configuration for BALANCE Agency.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "legalName": { "type": "string", "maxLength": 180 },
        "taxId": { "type": "string", "maxLength": 64 },
        "currency": { "type": "string", "enum": ["EGP", "USD", "SAR"] },
        "timezone": { "type": "string", "maxLength": 64 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "legalName", "currency", "timezone", "ownerUid", "createdAt", "updatedAt"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Operating branch belonging to BALANCE Agency.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 24 },
        "name": { "type": "string", "maxLength": 120 },
        "nameEn": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 250 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 120 },
        "managerUid": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "operationalBudgetPiasters": { "type": "integer" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "name", "status", "operationalBudgetPiasters", "ownerUid", "memberUids", "createdAt", "updatedAt"]
    },
    "Department": {
      "title": "Department",
      "description": "Functional department inside BALANCE Agency.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 24 },
        "name": { "type": "string", "maxLength": 120 },
        "nameEn": { "type": "string", "maxLength": 120 },
        "managerUid": { "type": "string", "maxLength": 128 },
        "budgetPiasters": { "type": "integer" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "name", "budgetPiasters", "ownerUid", "memberUids", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Internal user and employee identity profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 160 },
        "fullName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 64 },
        "branchIds": { "type": "array" },
        "departmentIds": { "type": "array" },
        "position": { "type": "string", "maxLength": 100 },
        "workModel": { "type": "string", "enum": ["office", "remote", "hybrid"] },
        "employmentType": { "type": "string", "enum": ["full_time", "part_time", "freelancer"] },
        "status": { "type": "string", "enum": ["active", "inactive", "invited"] },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "status", "ownerUid", "createdAt", "updatedAt"]
    },
    "Client": {
      "title": "Client",
      "description": "Single source of truth client entity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 140 },
        "industry": { "type": "string", "maxLength": 80 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 140 },
        "branchId": { "type": "string", "maxLength": 64 },
        "accountManagerUid": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "paused", "archived"] },
        "isDemo": { "type": "boolean" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "branchId", "status", "isDemo", "ownerUid", "memberUids", "createdAt", "updatedAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "CRM sales lead prior to conversion.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "businessName": { "type": "string", "maxLength": 140 },
        "contactName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 140 },
        "source": { "type": "string", "maxLength": 48 },
        "stage": { "type": "string", "maxLength": 48 },
        "estimatedBudgetPiasters": { "type": "integer" },
        "assignedUid": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 64 },
        "isDemo": { "type": "boolean" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "businessName", "contactName", "phone", "source", "stage", "estimatedBudgetPiasters", "branchId", "isDemo", "ownerUid", "memberUids", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Service execution project linked to a client and contract.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 160 },
        "clientId": { "type": "string", "maxLength": 64 },
        "contractId": { "type": "string", "maxLength": 64 },
        "serviceId": { "type": "string", "maxLength": 64 },
        "branchId": { "type": "string", "maxLength": 64 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "managerUid": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["draft", "planning", "ready", "active", "on_hold", "at_risk", "under_review", "completed", "cancelled"] },
        "approvedRevenuePiasters": { "type": "integer" },
        "estimatedCostPiasters": { "type": "integer" },
        "actualCostPiasters": { "type": "integer" },
        "isDemo": { "type": "boolean" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "clientId", "branchId", "departmentId", "managerUid", "status", "approvedRevenuePiasters", "isDemo", "ownerUid", "memberUids", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Cross-department operational task.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "projectId": { "type": "string", "maxLength": 64 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "assigneeUid": { "type": "string", "maxLength": 128 },
        "reviewerUid": { "type": "string", "maxLength": 128 },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["backlog", "ready", "assigned", "in_progress", "on_hold", "internal_review", "client_approval", "revision", "approved", "completed", "cancelled"] },
        "dueDate": { "type": "string", "maxLength": 32 },
        "isDemo": { "type": "boolean" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "projectId", "departmentId", "assigneeUid", "priority", "status", "dueDate", "isDemo", "ownerUid", "memberUids", "createdAt", "updatedAt"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Double-entry accounting journal entry (immutable once posted).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "entryNumber": { "type": "string", "maxLength": 40 },
        "date": { "type": "string", "maxLength": 32 },
        "description": { "type": "string", "maxLength": 300 },
        "periodId": { "type": "string", "maxLength": 64 },
        "branchId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["draft", "posted", "reversed"] },
        "totalDebitPiasters": { "type": "integer" },
        "totalCreditPiasters": { "type": "integer" },
        "isDemo": { "type": "boolean" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "entryNumber", "date", "description", "periodId", "branchId", "status", "totalDebitPiasters", "totalCreditPiasters", "isDemo", "ownerUid", "memberUids", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Expense claim requiring separation of duties for approval.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "description": { "type": "string", "maxLength": 240 },
        "amountPiasters": { "type": "integer" },
        "branchId": { "type": "string", "maxLength": 64 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "requesterUid": { "type": "string", "maxLength": 128 },
        "approverUid": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["submitted", "manager_review", "finance_review", "approved", "posted", "paid", "rejected"] },
        "isDemo": { "type": "boolean" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "description", "amountPiasters", "branchId", "departmentId", "requesterUid", "status", "isDemo", "ownerUid", "memberUids", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable append-only security and business audit record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 64 },
        "entity": { "type": "string", "maxLength": 64 },
        "entityId": { "type": "string", "maxLength": 64 },
        "summary": { "type": "string", "maxLength": 300 },
        "branchId": { "type": "string", "maxLength": 64 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "action", "entity", "entityId", "summary", "ownerUid", "memberUids", "createdAt"]
    },
    "ModuleRecord": {
      "title": "ModuleRecord",
      "description": "Generic validated operational entity record for BALANCE OS modules.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "memberUids": { "type": "array" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "memberUids", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/companies/{companyId}": { "schema": { "$ref": "#/entities/Company" }, "description": "Root company configuration." },
    "/branches/{branchId}": { "schema": { "$ref": "#/entities/Branch" }, "description": "Agency branches." },
    "/departments/{departmentId}": { "schema": { "$ref": "#/entities/Department" }, "description": "Agency departments." },
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" }, "description": "Internal user identity and role records." },
    "/users/{userId}/private/{docId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Restricted HR/salary PII subcollection." },
    "/invitations/{invitationId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Invite-only employee onboarding tokens." },
    "/roles/{roleId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "RBAC role definitions and permission matrices." },
    "/clients/{clientId}": { "schema": { "$ref": "#/entities/Client" }, "description": "Authoritative client directory." },
    "/leads/{leadId}": { "schema": { "$ref": "#/entities/Lead" }, "description": "CRM sales leads." },
    "/deals/{dealId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Sales pipeline deals." },
    "/proposals/{proposalId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Client proposals." },
    "/contracts/{contractId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Approved client contracts." },
    "/services/{serviceId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Central service catalog." },
    "/projects/{projectId}": { "schema": { "$ref": "#/entities/Project" }, "description": "Contracted service projects." },
    "/tasks/{taskId}": { "schema": { "$ref": "#/entities/Task" }, "description": "Cross-department tasks." },
    "/shoots/{shootId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Media production shoots." },
    "/equipmentReservations/{reservationId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Production equipment bookings." },
    "/editingJobs/{jobId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Video editing pipeline jobs." },
    "/designJobs/{jobId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Graphic design pipeline jobs." },
    "/marketingItems/{itemId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Marketing campaigns and content items." },
    "/devItems/{itemId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Development sprints, features, and bugs." },
    "/chartOfAccounts/{accountId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Configurable chart of accounts." },
    "/fiscalPeriods/{periodId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Fiscal periods with lock controls." },
    "/journalEntries/{entryId}": { "schema": { "$ref": "#/entities/JournalEntry" }, "description": "Double-entry accounting journal entries." },
    "/invoices/{invoiceId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Customer invoices." },
    "/payments/{paymentId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Customer and vendor payments." },
    "/expenses/{expenseId}": { "schema": { "$ref": "#/entities/Expense" }, "description": "Expense claims and approvals." },
    "/treasuryAccounts/{accountId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Branch cash and bank accounts." },
    "/treasuryTransfers/{transferId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Inter-account treasury transfers." },
    "/procurementRequests/{requestId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Procurement requests and POs." },
    "/assets/{assetId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Fixed assets and equipment register." },
    "/attendanceRecords/{recordId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Hybrid work attendance records." },
    "/leaveRequests/{requestId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Employee leave requests." },
    "/payrollRuns/{payrollId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Restricted payroll runs." },
    "/supportTickets/{ticketId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Customer service tickets." },
    "/files/{fileId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "File metadata library." },
    "/knowledgeArticles/{articleId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Internal SOPs and knowledge base." },
    "/workflows/{workflowId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Workflow automation rules." },
    "/workflowLogs/{logId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Automation execution logs." },
    "/approvals/{approvalId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "Centralized approval requests." },
    "/notifications/{notificationId}": { "schema": { "$ref": "#/entities/ModuleRecord" }, "description": "User notifications." },
    "/auditLogs/{logId}": { "schema": { "$ref": "#/entities/AuditLog" }, "description": "Immutable system audit log." }
  }
}
